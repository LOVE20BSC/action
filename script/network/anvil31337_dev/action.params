# Verification-open split lines (not reward tiers): empty = no tiers, only the top-voted verifier
# can verify; non-empty = strictly increasing, each in (0, 1e18).
# Rank k (k >= 2) opens at SPLITS[k-2] of this round's verification phase; open slots = count + 1.
# Passed to DeployAction.s.sol as run(uint256[]).
GROUP_ACTION_SPLITS=1e17,4e17,7e17      # rank 2 at 10% / rank 3 at 40% / rank 4 at 70%
